# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# Название сервиса (в приветствии и в приложении AmneziaVPN)
SERVER_NAME=MyVPN
# Публичный IP или домен сервера (попадёт в Endpoint). Пусто = определить автоматически
SERVER_HOST=
# Часовой пояс для дат и суточной статистики
TZ_NAME=Europe/Moscow

# ---- Оплата (вручную) ----
# Реквизиты, которые увидит клиент при выборе тарифа. \n — перенос строки
PAYMENT_DETAILS=Переведите сумму на карту <code>2200 0000 0000 0000</code> (Т-Банк, Иван И.)\nили по СБП на номер <code>+7 900 000-00-00</code>
CURRENCY=₽
# Контакт поддержки (показывается в помощи и при отклонении оплаты)
SUPPORT=@your_support

# ---- Подписка ----
# Скидка новичкам на первую оплату, % (0 — отключить)
FIRST_DISCOUNT_PERCENT=50
# На тарифы до скольких дней действует скидка (31 — только месячный; 365 — на любой)
FIRST_DISCOUNT_MAX_DAYS=31
# Бонус пригласившему за первую оплату друга, дней (0 — отключить)
REF_BONUS_DAYS=7
# Лимит устройств, если админ продлил подписку вручную без тарифа
DEFAULT_DEVICES=1
# Как часто собирать статистику трафика, секунд
STATS_INTERVAL=300

# ---- Клиентский конфиг ----
# DNS для клиентов. Если на сервере установлен AmneziaDNS — можно указать 172.29.172.254
DNS1=1.1.1.1
DNS2=1.0.0.1
# MTU в .conf (необязательно)
CLIENT_MTU=

# ---- Сервер AWG (обычно определяется автоматически) ----
AWG_CONTAINER=
# AWG_CONFIG_PATH=/opt/amnezia/awg/awg0.conf
# AWG_INTERFACE=awg0
# AWG_BIN=awg

# Демо-режим без VPN-сервера: 1 — эмулировать сервер локально (для проверки бота)
AWG_MOCK=0

DB_PATH=data/bot.db
