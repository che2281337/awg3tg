# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# Публичный IP или домен сервера (попадёт в Endpoint). Пусто = определить автоматически
SERVER_HOST=
# Название сервера в приложении AmneziaVPN
SERVER_NAME=My AmneziaWG

# Доступ: open — всем сразу; approval — по заявке с кнопкой одобрения у админа;
# closed — только тем, кого админ добавил командой /approve ID
ACCESS_MODE=approval
# Сколько ключей (устройств) может получить один пользователь
MAX_KEYS_PER_USER=1

# DNS для клиентов. Если на сервере установлен AmneziaDNS — можно указать 172.29.172.254
DNS1=1.1.1.1
DNS2=1.0.0.1
# MTU в .conf (необязательно; приложение Amnezia по умолчанию использует 1376 / 1280 на мобильных)
CLIENT_MTU=

# Обычно определяется автоматически: amnezia-awg2 (AWG 2.0/3.x) или amnezia-awg (legacy)
AWG_CONTAINER=
# AWG_CONFIG_PATH=/opt/amnezia/awg/awg0.conf
# AWG_INTERFACE=awg0
# AWG_BIN=awg

DB_PATH=data/bot.db
